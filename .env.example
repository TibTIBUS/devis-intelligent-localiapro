# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local

# Supabase — clé publiable uniquement côté navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — secret serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — secrets utilisés uniquement par Supabase Auth
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# OpenAI — secrets serveur uniquement
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REALTIME_MODEL=

# Tests E2E optionnels — jamais utilisés en production
E2E_BASE_URL=http://127.0.0.1:3000
E2E_ENVIRONMENT=isolated
E2E_EMAIL=
E2E_PASSWORD=
E2E_FINALIZED_QUOTE_ID=
E2E_DOCUMENT_ID=
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
