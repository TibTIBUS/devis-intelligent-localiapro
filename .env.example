# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local

# Supabase — clé publiable uniquement côté navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — secret serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — secrets utilisés uniquement par Supabase Auth
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# OpenAI — secrets serveur uniquement
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REALTIME_MODEL=
